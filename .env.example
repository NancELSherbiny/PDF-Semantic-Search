# Copy to .env to override defaults. Every value is optional; the app runs on
# the defaults below with no .env file present.

# API
API_TITLE=PDF Ingestor & Semantic Search API
API_VERSION=1.0.0
LOG_LEVEL=INFO

# Embedding (vector dimension is derived from the model, not configured)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NORMALIZE_EMBEDDINGS=true

# Chunking
CHUNK_SIZE=180
CHUNK_OVERLAP=30

# Ingestion
INGEST_BASE_DIR=/data

# Vector store (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=pdf_chunks
DISTANCE_METRIC=cosine

# Search
TOP_K=5
SCORE_THRESHOLD=0.0

# Cache — disabled for the assessment. Enable later without code changes.
CACHE_ENABLED=false
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1024
